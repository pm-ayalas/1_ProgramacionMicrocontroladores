00035b 3006                      	CPI		R16, 6
00035c f021                      	BREQ	REINICIO42
00035d 9503                      	INC		R16
00035e 9300 010c                 	STS		TEMP_MIN_DECENA, R16
000360 c003                      	RJMP	FIN_REFRESCAR_MODO4
                                 
                                 REINICIO42:
