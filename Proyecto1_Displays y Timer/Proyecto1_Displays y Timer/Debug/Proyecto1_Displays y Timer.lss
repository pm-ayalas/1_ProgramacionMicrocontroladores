0002ec 9300 0102                 	STS		MIN_UNIDAD, R16
0002ee c05e                      	RJMP	FIN_REFRESCAR_RELOJ
                                 
                                 REINICIO3:
0002ef e000                      	LDI		R16, 0
0002f0 9300 0102                 	STS		MIN_UNIDAD, R16
                                 
                                 	// ================================ //
                                 	// MINUTOS DECENAS
                                 	// ================================ //
0002f2 9100 0103                 	LDS		R16, MIN_DECENA
0002f4 3006                      	CPI		R16, 6
0002f5 f021                      	BREQ	REINICIO4
0002f6 9503                      	INC		R16
0002f7 9300 0103                 	STS		MIN_DECENA, R16
0002f9 c053                      	RJMP	FIN_REFRESCAR_RELOJ
                                 
                                 REINICIO4:
0002fa e000                      	LDI		R16, 0
0002fb 9300 0103                 	STS		MIN_DECENA, R16
                                 
                                 	// ================================ //
                                 	// HORAS (COMPLETO)
                                 	// ================================ //
0002fd 9110 0104                 	LDS		R17, HRS_UNIDAD
0002ff 9120 0105                 	LDS		R18, HRS_DECENA
                                 
000301 3022                      	CPI		R18, 2
000302 f069                      	BREQ	INCREMENTAR_HRS_UNIDAD
                                 
000303 3019                      	CPI		R17, 9
000304 f021                      	BREQ	INCREMENTAR_HRS_DECENA
000305 9513                      	INC		R17
000306 9310 0104                 	STS		HRS_UNIDAD, R17
000308 c044                      	RJMP	FIN_REFRESCAR_RELOJ
                                 
                                 INCREMENTAR_HRS_DECENA:
000309 9523                      	INC		R18
00030a e010                      	LDI		R17, 0
00030b 9310 0104                 	STS		HRS_UNIDAD, R17
00030d 9320 0105                 	STS		HRS_DECENA, R18
00030f c03d                      	RJMP	FIN_REFRESCAR_RELOJ
                                 
                                 INCREMENTAR_HRS_UNIDAD:
000310 3014                      	CPI		R17, 4
000311 f021                      	BREQ	REINICIO5
000312 9513                      	INC		R17
000313 9310 0104                 	STS		HRS_UNIDAD, R17
000315 c037                      	RJMP	FIN_REFRESCAR_RELOJ
                                 
                                 REINICIO5:
000316 e010                      	LDI		R17, 0
000317 9310 0104                 	STS		HRS_UNIDAD, R17
000319 9310 0105                 	STS		HRS_DECENA, R17	
                                 
                                 	// ================================ //
                                 	// DIAS (COMPLETO)
                                 	// ================================ //
00031b 9100 0107                 	LDS		R16, DIA_DECENA
00031d 9110 0106                 	LDS		R17, DIA_UNIDAD
                                 
                                 	// Fusionar DÍAS
00031f 2f20                      	MOV		R18, R16
000320 e03a                      	LDI		R19, 10
000321 9f23                      	MUL		R18, R19
000322 0f21                      	ADD		R18, R17	
                                 
                                 	// Obtener días correspondientes
000323 940e 0368                 	CALL	OBTENER_DIAS_DEL_MES				// R21 = días del mes
                                 
                                 	// Incrementar día
000325 9523                      	INC		R18
                                 
000326 1725                      	CP		R18, R21
000327 f039                      	BREQ	DIA_REINICIAR
                                 
                                 	// Regresar FUSION a UNIDAD y DECENA
000328 940e 0383                 	CALL	DES_FUSIONAR						// R20 = decenas | R21 = unidades
                                 
00032a 9340 0107                 	STS		DIA_DECENA, R20
00032c 9350 0106                 	STS		DIA_UNIDAD, R21
00032e c01e                      	RJMP	FIN_REFRESCAR_RELOJ
                                 
                                 DIA_REINICIAR:
00032f e040                      	LDI		R20, 0
000330 9340 0107                 	STS		DIA_DECENA, R20
000332 e041                      	LDI		R20, 1
000333 9340 0106                 	STS		DIA_UNIDAD, R20
                                 	
                                 	// Ahora incrementar MES	
                                 
                                 	// ================================ //
                                 	// MES (COMPLETO)
                                 	// ================================ //
000335 9100 0109                 	LDS		R16, MES_DECENA
000337 9110 0108                 	LDS		R17, MES_UNIDAD
                                 
                                 	// Fusionar DÍAS
000339 2f20                      	MOV		R18, R16
00033a e03a                      	LDI		R19, 10
00033b 9f23                      	MUL		R18, R19
00033c 0f21                      	ADD		R18, R17
                                 
00033d 9523                      	INC		R18									// Incrementar MES
                                 
00033e 302d                      	CPI		R18, 13								// mantener margen de 12 meses
00033f f039                      	BREQ	MES_REINICIAR
                                 
                                 	// Regresar FUSION a UNIDAD y DECENA
000340 940e 0383                 	CALL	DES_FUSIONAR						// R20 = decenas | R21 = unidades
                                 	
000342 9340 0109                 	STS		MES_DECENA, R20
000344 9350 0108                 	STS		MES_UNIDAD,	R21
000346 c006                      	RJMP	FIN_REFRESCAR_RELOJ
                                 
                                 MES_REINICIAR:
                                 
                                 	// Reiniciar a enero (01)
000347 e040                      	LDI		R20, 0
000348 9340 0109                 	STS		MES_DECENA, R20
00034a e051                      	LDI		R21, 1
00034b 9350 0108                 	STS		MES_UNIDAD, R21
                                 
                                 FIN_REFRESCAR_RELOJ:
00034d 9508                      	RET
                                 
                                 // ############################################################################## // -- Refrescar información pero con Valores Temporales
                                 REFRESCAR_MODO4:		// ----------------------------- MINUTOS
                                 
                                 	// ================================ //
