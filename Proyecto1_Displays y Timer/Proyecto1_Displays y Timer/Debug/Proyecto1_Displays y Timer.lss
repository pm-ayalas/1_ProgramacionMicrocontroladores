                                 /*******************************************************************************************************/
                                 // ENCABEZADO 
                                 
                                 // Encabezado (Definición de Registros, Variables y Constantes)
                                 .include "M328PDEF.inc"							// Include definitions specific to ATMega328P
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega328P.xml **********
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m328Pdef.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega328P
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega328P
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M328PDEF_INC_
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 // ================================ //
                                 // DATOS EN SRAM
                                 // ================================ //
                                 .dseg
                                 .org    SRAM_START
                                 
000100                           SEG_UNIDAD:				.BYTE 1					// Valores Segundos
000101                           SEG_DECENA:				.BYTE 1
000102                           MIN_UNIDAD:				.BYTE 1					// Valores Minutos
000103                           MIN_DECENA:				.BYTE 1
000104                           HRS_UNIDAD:				.BYTE 1					// Valores Horas
000105                           HRS_DECENA:				.BYTE 1		
000106                           DIA_UNIDAD:				.BYTE 1					// Valores Días
000107                           DIA_DECENA:				.BYTE 1
000108                           MES_UNIDAD:				.BYTE 1					// Valores Mes
000109                           MES_DECENA:				.BYTE 1
00010a                           ANIO:					.BYTE 1					// Valor Año	
                                 
00010b                           TEMP_MIN_UNIDAD:		.BYTE 1					// Valores para configuración MODO 4
00010c                           TEMP_MIN_DECENA:		.BYTE 1
00010d                           TEMP_HRS_UNIDAD:		.BYTE 1					// Valores para configuración MODO 5
00010e                           TEMP_HRS_DECENA:		.BYTE 1
00010f                           TEMP_MES_UNIDAD:		.BYTE 1					// Valores para configuración MODO 6
000110                           TEMP_MES_DECENA:		.BYTE 1
000111                           TEMP_DIA_UNIDAD:		.BYTE 1					// Valores para configuración MODO 7
000112                           TEMP_DIA_DECENA:		.BYTE 1
                                 
000113                           ALARMA_MIN_UNIDAD:		.BYTE 1					// Valores Minutos para configuración ALARMA
000114                           ALARMA_MIN_DECENA:		.BYTE 1
000115                           ALARMA_HRS_UNIDAD:		.BYTE 1					// Valores Horas para configuración ALARMA
000116                           ALARMA_HRS_DECENA:		.BYTE 1		
                                 
000117                           DISPLAY_ACTUAL:			.BYTE 1					// Variable para ubicar el display mostrado
000118                           MODO:					.BYTE 1					// Modo actual - define lo que se mostrará 
                                 
000119                           ALARMA:					.BYTE 1					// Estado de la alarma y valores
00011a                           ALARMA_MIN:				.BYTE 1
00011b                           ALARMA_HRS:				.BYTE 1
                                 
00011c                           C_SEGUNDOS:				.BYTE 1					// Contador para las 100 interrupciones (llegar a 1seg)
00011d                           PUNTITOS:				.BYTE 1					// Variable para estado PUNTITOS
                                 
00011e                           BTN_INC:				.BYTE 1					// Bandera btn incremento
00011f                           BTN_DEC:				.BYTE 1					// Bandera btn decremento
                                 
000120                           GUARDAR_VALORES:		.BYTE 1					// Bandera para guardar nuevos valores en Modo Configuración
                                 	
                                 // ================================ //
                                 // FALSH
                                 // ================================ //
                                 .cseg
                                 .org 0x0000
                                 
                                 // ================================ //
                                 // VECTOR INTERRUPCIONES
                                 // ================================ //
000000 940c 001e                 JMP		PILA
                                 
                                 .ORG	0x0008									// Dirección vector PCINT1
000008 940c 039f                 JMP		BTN_ISR
                                 .ORG	0x001C									// Dirección OC0Aaddr	
00001c 940c 038b                 JMP		TIM0_ISR			
                                 
                                 /*******************************************************************************************************/
                                 // Configuración de la pila
                                 PILA:
00001e ef0f                      	LDI     R16, LOW(RAMEND)
00001f bf0d                      	OUT     SPL, R16
000020 e008                      	LDI     R16, HIGH(RAMEND)
000021 bf0e                      	OUT     SPH, R16
                                 
                                 /*******************************************************************************************************/
                                 // Configuracion MCU
                                 SETUP:
                                 
                                 	// Prescaler principal
000022 e800                      	LDI		R16, (1 << CLKPCE)
000023 9300 0061                 	STS		CLKPR, R16							// Habilitar cambio de PRESCALER
000025 e004                      	LDI		R16, 0b00000100
000026 9300 0061                 	STS		CLKPR, R16							// Configurar Prescaler a 16 F_cpu = 1MHz
                                 
                                 	// Deshabilitar serial (RX, TX)
000028 e000                      	LDI		R16, 0x00
000029 9300 00c1                 	STS		UCSR0B, R16
                                 
                                 	// ================================ //
                                 	// CONFIGURACIÓN PUERTOS
                                 	// ================================ //
                                 
                                 	// PuertoB => Multiplexación PB0-PB3 || ALARMA PB4 || LED Config PB5
00002b e30f                      	LDI		R16, 0b00111111
00002c b904                      	OUT		DDRB, R16
00002d e000                      	LDI		R16, 0b00000000						// Inicia Apagado
00002e b905                      	OUT		PORTB, R16
                                 
                                 	// PuertoD => Displays PD0-PD6 || Puntitos PD7
00002f ef0f                      	LDI		R16, 0b11111111
000030 b90a                      	OUT		DDRD, R16
000031 e70f                      	LDI		R16, 0b01111111						// Inicia Apagado
000032 b90b                      	OUT		PORTD, R16
                                 
                                 	// PuertoC => Botones PC0-PC3 || LEDs Estados PV4-PC5
000033 e300                      	LDI		R16, 0b00110000
000034 b907                      	OUT		DDRC, R16
000035 e00f                      	LDI		R16, 0b00001111						// pull-up habilitado btns
000036 b908                      	OUT		PORTC, R16
                                 
                                 	// ================================ //
                                 	// CONFIG INTERRUPCIONES
                                 	// INICIALIZAR TIMER0
                                 	// ================================ //
                                 
                                 	// PIN-CHANGE - Habilitar interrupciones 
000037 e002                      	LDI		R16, (1 << PCIE1)					// 0b00000010
000038 9300 0068                 	STS		PCICR, R16
                                 
                                 	// Habilitamos pines específicos (btns - PC0-PC1)
00003a e00f                      	LDI		R16, (1 << PCINT8) | (1 << PCINT9)	| (1 << PCINT10) | (1 << PCINT11)
00003b 9300 006c                 	STS		PCMSK1, R16
                                 
                                 	// INICIALIZAR TIMER0 ====== //
00003d 940e 0102                 	CALL	IN_TIMER0
                                 
                                 	// VALORES INICIALES ======= //
00003f e000                      	LDI		R16, 0x00
000040 9300 0100                 	STS		SEG_UNIDAD, R16
000042 9300 0101                 	STS		SEG_DECENA, R16
000044 9300 0102                 	STS		MIN_UNIDAD, R16
000046 9300 0103                 	STS		MIN_DECENA, R16
000048 9300 0104                 	STS		HRS_UNIDAD, R16
00004a 9300 0105                 	STS		HRS_DECENA, R16
                                 
00004c 9300 0107                 	STS		DIA_DECENA, R16
00004e 9300 0109                 	STS		MES_DECENA, R16
000050 9300 0119                 	STS		ALARMA, R16
                                 
000052 9300 0113                 	STS		ALARMA_MIN_UNIDAD, R16
000054 9300 0114                 	STS		ALARMA_MIN_DECENA, R16
000056 9300 0115                 	STS		ALARMA_HRS_UNIDAD, R16
000058 9300 0116                 	STS		ALARMA_HRS_DECENA, R16
                                 
00005a 9300 011d                 	STS		PUNTITOS, R16
00005c 9300 011c                 	STS		C_SEGUNDOS, R16
00005e 9300 011e                 	STS		BTN_INC, R16
000060 9300 011f                 	STS		BTN_DEC, R16
                                 
000062 9300 010b                 	STS		TEMP_MIN_UNIDAD, R16
000064 9300 010c                 	STS		TEMP_MIN_DECENA, R16
000066 9300 010d                 	STS		TEMP_HRS_UNIDAD, R16
000068 9300 010e                 	STS		TEMP_HRS_DECENA, R16
00006a 9300 010f                 	STS		TEMP_MES_UNIDAD, R16
00006c 9300 0110                 	STS		TEMP_MES_DECENA, R16
00006e 9300 0111                 	STS		TEMP_DIA_UNIDAD, R16
000070 9300 0112                 	STS		TEMP_DIA_DECENA, R16
                                 
000072 9300 0120                 	STS		GUARDAR_VALORES, R16
                                 
000074 e001                      	LDI		R16, 1
000075 9300 0106                 	STS		DIA_UNIDAD, R16
000077 9300 0108                 	STS		MES_UNIDAD, R16
000079 9300 0117                 	STS		DISPLAY_ACTUAL, R16
00007b 9300 0118                 	STS		MODO, R16
                                 	
                                 	// habilitar interrupciones
00007d 9478                      	SEI
                                 	    
                                 /****************************************/
                                 // Loop Infinito
                                 MAIN_LOOP:
                                 
                                 	// Contador 0.5 seg
00007e 9100 011c                 	LDS		R16, C_SEGUNDOS
000080 3604                      	CPI		R16, 100
000081 f469                      	BRNE	VERIFICAR_1S
                                 		
000082 9140 0118                 	LDS		R20, MODO							// Encender puntitos según modo
000084 3043                      	CPI		R20, 3
000085 f0a1                      	BREQ	DISPLAYSS
000086 3046                      	CPI		R20, 6
000087 f091                      	BREQ	DISPLAYSS
000088 3047                      	CPI		R20, 7
000089 f081                      	BREQ	DISPLAYSS
                                 
00008a 9a5f                      	SBI		PORTD, 7							// Encender puntitos
00008b e800                      	LDI		R16, 0b10000000						// Modificar Bandera PUNTITOS
00008c 9300 011d                 	STS		PUNTITOS, R16
00008e c00b                      	RJMP	DISPLAYSS
                                 
                                 VERIFICAR_1S:
                                 	// Contador 1 seg
00008f 3c08                      	CPI		R16, 200
000090 f449                      	BRNE	DISPLAYSS							// si no se ha cumplido el segundo, continuamos
                                 
                                 	// si se ha llegado al 1S
000091 985f                      	CBI		PORTD, 7							// Apagar puntitos
000092 e000                      	LDI		R16, 0b00000000						// Modificar Bandera PUNTITOS
000093 9300 011d                 	STS		PUNTITOS, R16
000095 940e 02d1                 	CALL	REFRESCAR_RELOJ1					// Actulizar valores de reloj
000097 2700                      	CLR		R16
000098 9300 011c                 	STS		C_SEGUNDOS, R16						// Limpiar contador Segundos
                                 
                                 DISPLAYSS:
                                 	// Mostrar valores en display correspondiente
                                 	// (Mandar señal a transistor según display)
00009a 940e 010e                 	CALL	DISPLAY_CORRESPONDIENTE
                                 
                                 	// Mostrar en protoboard según modo
00009c 9100 0118                 	LDS		R16, MODO
                                 	
00009e 3001                      	CPI		R16, 1
00009f f431                      	BRNE	REVISAR_M2
0000a0 9a44                      	SBI		PORTC, 4	//	
0000a1 9845                      	CBI		PORTC, 5	//
0000a2 982d                      	CBI		PORTB, 5	//
0000a3 940e 012b                 	CALL	MOSTRAR_MODO1
0000a5 c05b                      	RJMP	MAIN_LOOP1
                                 
                                 REVISAR_M2:
0000a6 3002                      	CPI		R16, 2
0000a7 f431                      	BRNE	REVISAR_M3
0000a8 9a44                      	SBI		PORTC, 4	//
0000a9 9845                      	CBI		PORTC, 5	//
0000aa 982d                      	CBI		PORTB, 5	//
0000ab 940e 0148                 	CALL	MOSTRAR_MODO2
0000ad c053                      	RJMP	MAIN_LOOP1
                                 REVISAR_M3:
0000ae 3003                      	CPI		R16, 3
0000af f431                      	BRNE	REVISAR_M4
0000b0 9844                      	CBI		PORTC, 4	//
0000b1 9a45                      	SBI		PORTC, 5	//
0000b2 982d                      	CBI		PORTB, 5	//
0000b3 940e 0165                 	CALL	MOSTRAR_MODO3
0000b5 c04b                      	RJMP	MAIN_LOOP1
                                 REVISAR_M4:
0000b6 3004                      	CPI		R16, 4
0000b7 f431                      	BRNE	REVISAR_M5
0000b8 9a44                      	SBI		PORTC, 4	//
0000b9 9845                      	CBI		PORTC, 5	//
0000ba 9a2d                      	SBI		PORTB, 5	//
0000bb 940e 0182                 	CALL	MOSTRAR_MODO4
0000bd c043                      	RJMP	MAIN_LOOP1
                                 REVISAR_M5:
0000be 3005                      	CPI		R16, 5
0000bf f431                      	BRNE	REVISAR_M6
0000c0 9a44                      	SBI		PORTC, 4	//
0000c1 9845                      	CBI		PORTC, 5	//
0000c2 9a2d                      	SBI		PORTB, 5	//
0000c3 940e 01df                 	CALL	MOSTRAR_MODO5
0000c5 c03b                      	RJMP	MAIN_LOOP1
                                 REVISAR_M6:
0000c6 3006                      	CPI		R16, 6
0000c7 f431                      	BRNE	REVISAR_M7
0000c8 9844                      	CBI		PORTC, 4	//
0000c9 9a45                      	SBI		PORTC, 5	//
0000ca 9a2d                      	SBI		PORTB, 5	//
0000cb 940e 0229                 	CALL	MOSTRAR_MODO6
0000cd c033                      	RJMP	MAIN_LOOP1
                                 REVISAR_M7:
0000ce 3007                      	CPI		R16, 7
0000cf f431                      	BRNE	REVISAR_M8
0000d0 9844                      	CBI		PORTC, 4	//
0000d1 9a45                      	SBI		PORTC, 5	//
0000d2 9a2d                      	SBI		PORTB, 5	//
0000d3 940e 0273                 	CALL	MOSTRAR_MODO7
0000d5 c02b                      	RJMP	MAIN_LOOP1
                                 REVISAR_M8:
0000d6 3008                      	CPI		R16, 8
0000d7 f431                      	BRNE	REVISAR_M9
0000d8 9844                      	CBI		PORTC, 4	//
0000d9 9845                      	CBI		PORTC, 5	//
0000da 9a2d                      	SBI		PORTB, 5	//
0000db 940e 0182                 	CALL	MOSTRAR_MODO4
0000dd c023                      	RJMP	MAIN_LOOP1
                                 REVISAR_M9:
0000de 3009                      	CPI		R16, 9
0000df f509                      	BRNE	MAIN_LOOP1
0000e0 9844                      	CBI		PORTC, 4	//
0000e1 9845                      	CBI		PORTC, 5	//
0000e2 9a2d                      	SBI		PORTB, 5	//
0000e3 940e 01df                 	CALL	MOSTRAR_MODO5
                                 
                                 // ========================================== //
                                 // Lógica verificar ALARMA
                                 // ========================================== //
                                 
0000e5 9100 0116                 	LDS		R16, ALARMA_HRS_DECENA
0000e7 9110 0105                 	LDS		R17, HRS_DECENA
0000e9 1701                      	CP		R16, R17
0000ea f009                      	BREQ	VERIFICAR2
0000eb c015                      	RJMP	MAIN_LOOP1
                                 
                                 VERIFICAR2:
0000ec 9100 0115                 	LDS		R16, ALARMA_HRS_UNIDAD
0000ee 9110 0104                 	LDS		R17, HRS_UNIDAD
0000f0 1701                      	CP		R16, R17
0000f1 f009                      	BREQ	VERIFICAR3
0000f2 c00e                      	RJMP	MAIN_LOOP1
                                 
                                 VERIFICAR3:
0000f3 9100 0114                 	LDS		R16, ALARMA_MIN_DECENA
0000f5 9110 0103                 	LDS		R17, MIN_DECENA
0000f7 1701                      	CP		R16, R17
0000f8 f009                      	BREQ	VERIFICAR4
0000f9 c007                      	RJMP	MAIN_LOOP1
                                 
                                 VERIFICAR4:
0000fa 9100 0113                 	LDS		R16, ALARMA_MIN_UNIDAD
0000fc 9110 0102                 	LDS		R17, MIN_UNIDAD
0000fe 1701                      	CP		R16, R17
0000ff f009                      	BREQ	ENCENDER_ALARMA
000100 c000                      	RJMP	MAIN_LOOP1
                                 
                                 ENCENDER_ALARMA:
                                 
                                 MAIN_LOOP1:
000101 cf7c                          RJMP    MAIN_LOOP
                                 
                                 /****************************************/
                                 // NON-Interrupt subroutines
                                 
                                 IN_TIMER0:
                                 	// Modo CTC (Clear Timer on Compare Match)
000102 e002                      	LDI		R16, (1 << WGM01)
000103 bd04                      	OUT		TCCR0A, R16
                                 
                                 	// Prescaler 64
000104 e003                      	LDI		R16, (0 << CS02) | (1 << CS01) | (1 << CS00)  
000105 bd05                      	OUT		TCCR0B, R16
                                 	
                                 	// Valor para 5ms
000106 e40e                      	LDI		R16, 78							// R: 78
000107 bd07                      	OUT		OCR0A, R16
                                 
                                 	// habilitar interrupciones por comparacion
000108 e002                      	LDI		R16, (1 << OCIE0A)
000109 9300 006e                 	STS		TIMSK0, R16
                                 	
                                 	// Iniciar contador en 0
00010b e000                      	LDI		R16, 0x00
00010c bd06                      	OUT		TCNT0, R16
                                 
00010d 9508                      	RET
                                 
                                 DISPLAY_CORRESPONDIENTE:
                                 
00010e 9100 0117                 	LDS		R16, DISPLAY_ACTUAL
000110 3001                      	CPI		R16, 1
000111 f049                      	BREQ	UNIDADES1
                                 
000112 3002                      	CPI		R16, 2
000113 f061                      	BREQ	DECENAS1
                                 
000114 3003                      	CPI		R16, 3
000115 f079                      	BREQ	UNIDADES2
                                 
                                 	// sino, el display actual es DECENAS2
000116 9828                      	CBI		PORTB, 0
000117 9829                      	CBI		PORTB, 1
000118 982a                      	CBI		PORTB, 2
000119 9a2b                      	SBI		PORTB, 3
00011a c00f                      	RJMP	FIN_DISPLAY_CORRESPONDIENTE
                                 
                                 UNIDADES1:
00011b 9a28                      	SBI		PORTB, 0
00011c 9829                      	CBI		PORTB, 1
00011d 982a                      	CBI		PORTB, 2
00011e 982b                      	CBI		PORTB, 3
00011f c00a                      	RJMP	FIN_DISPLAY_CORRESPONDIENTE
                                 
                                 DECENAS1:
000120 9828                      	CBI		PORTB, 0
000121 9a29                      	SBI		PORTB, 1
000122 982a                      	CBI		PORTB, 2
000123 982b                      	CBI		PORTB, 3
000124 c005                      	RJMP	FIN_DISPLAY_CORRESPONDIENTE
                                 UNIDADES2:
000125 9828                      	CBI		PORTB, 0
000126 9829                      	CBI		PORTB, 1
000127 9a2a                      	SBI		PORTB, 2
000128 982b                      	CBI		PORTB, 3
000129 c000                      	RJMP	FIN_DISPLAY_CORRESPONDIENTE
                                 
                                 FIN_DISPLAY_CORRESPONDIENTE:
00012a 9508                      	RET
                                 
                                 // ================================ //
                                 // MODO 1 => MIN:SEG
                                 // ================================ //
                                 MOSTRAR_MODO1:
00012b 9100 0117                 	LDS		R16, DISPLAY_ACTUAL					// Enviar valor según DISPLAY ACTUAL
                                 
00012d 3001                      	CPI		R16, 1
00012e f029                      	BREQ	M1_DISP1
00012f 3002                      	CPI		R16, 2
000130 f041                      	BREQ	M1_DISP2
000131 3003                      	CPI		R16, 3
