                                 REFRESCAR_MODO5:		// ----------------------------- HRS
000365 9508                      RET
                                 
                                 REFRESCAR_MODO6:		// ----------------------------- MESES
000366 9508                      RET
                                 
                                 REFRESCAR_MODO7:		// ----------------------------- DIAS (en rango del mes actual)
000367 9508                      RET
                                 
                                 // ############################################################################## //
                                 
                                 OBTENER_DIAS_DEL_MES:
                                 
000368 93ff                      	PUSH	ZH
000369 93ef                      	PUSH	ZL
00036a 930f                      	PUSH	R16
00036b 931f                      	PUSH	R17
00036c 933f                      	PUSH	R19
                                 
                                 	// verificar mes actual
00036d 9100 0109                 	LDS		R16, MES_DECENA
00036f 9110 0108                 	LDS		R17, MES_UNIDAD
                                 
                                 	// Fusionar
000371 2f30                      	MOV		R19, R16
000372 e04a                      	LDI		R20, 10
000373 9f34                      	MUL		R19, R20
000374 0f31                      	ADD		R19, R17
                                 
                                 	// Verificar en vector
000375 e0f7                      	LDI		ZH, HIGH(DIAS_DEL_MES*2)
000376 ecec                      	LDI		ZL, LOW(DIAS_DEL_MES*2)
000377 953a                      	DEC		R19									// Indice de Enero => 0
000378 0f33                      	LSL		R19									// mult por 2 porque dw ocupa 2 bytes
                                 
000379 0fe3                      	ADD		ZL, R19
00037a e000                      	LDI		R16, 0
00037b 1ff0                      	ADC		ZH, R16								// ZH = ZH + R16 + C (sumar acarreo si hubo)
00037c 9154                      	LPM		R21, Z								// Load Program Memory (cargar según puntero)
                                 
00037d 913f                      	POP		R19
00037e 911f                      	POP		R17
00037f 910f                      	POP		R16
000380 91ef                      	POP		ZL
000381 91ff                      	POP		ZH
000382 9508                      	RET
                                 
                                 DES_FUSIONAR:									// R18 => número por separar
                                 	
000383 2744                      	CLR		R20									// Registro para llevar conteo de resta de 10
000384 2f52                      	MOV		R21, R18							// copia del numero original
                                 
                                 DIVISION:										// bucle para contar decenas
000385 305a                      	CPI		R21, 10								// se repite mientras R21 sea mayor o igual a 10
000386 f01c                      	BRLT	FIN_DES_FUSIONAR					// Branch if Lower Than
                                 
                                 	// R21 sigue siendo > 10
000387 505a                      	SUBI	R21, 10								// R21 - 10
000388 9543                      	INC		R20									// incremento en decenas
000389 cffb                      	RJMP	DIVISION							// repetir
                                 
                                 FIN_DES_FUSIONAR:
00038a 9508                      	RET
                                 
                                 /****************************************/
                                 // Interrupt routines
                                 TIM0_ISR:
                                 
00038b 930f                      	PUSH	R16
00038c b70f                      	IN		R16, SREG
00038d 930f                      	PUSH	R16
                                 
                                 	// incrementar contador 1 segundo
00038e 9100 011c                 	LDS		R16, C_SEGUNDOS
000390 9503                      	INC		R16
000391 9300 011c                 	STS		C_SEGUNDOS, R16
                                 
                                 	// modificar Display actual 
000393 9100 0117                 	LDS		R16, DISPLAY_ACTUAL
000395 9503                      	INC		R16
000396 3005                      	CPI		R16, 5								// martener margen de 4 displays
000397 f409                      	BRNE	ACTUALIZAR1
000398 e001                      	LDI		R16, 1
                                 
                                 ACTUALIZAR1:
000399 9300 0117                 	STS		DISPLAY_ACTUAL, R16
                                 
00039b 910f                      	POP		R16
00039c bf0f                      	OUT		SREG, R16
00039d 910f                      	POP		R16
                                 
00039e 9518                      	RETI
                                 
                                 BTN_ISR:
                                 
                                 	// ================================ //
                                 	// PC0 => Decremento
                                 	// PC1 => Incremento
                                 	// PC2 => Modo
                                 	// PC3 => Comodin (Guardar / Apagar Alarma)
                                 	// ================================ //
                                 
                                 	// Guardar en pila
00039f 930f                      	PUSH	R16								
0003a0 931f                      	PUSH	R17	
0003a1 b70f                      	IN		R16, SREG							// Guardar Status Register
0003a2 930f                      	PUSH	R16	
                                 
                                 	// Lectura botones
0003a3 b116                      	IN		R17, PINC
                                 
0003a4 ff13                      	SBRS	R17, 3								// Verificar Btn Comodin
0003a5 c001                      	RJMP	REVISAR_MODO
0003a6 c00e                      	RJMP	BTN_COMODIN_PRESS
                                 
                                 REVISAR_MODO:
0003a7 ff12                      	SBRS	R17, 2								// Verificar Btn Modo
0003a8 c001                      	RJMP	REVISAR_INC_DEC
0003a9 c01a                      	RJMP	BTN_MODO_PRESS	
                                 
                                 	// Los botones estarán habilitados según el modo actual
                                 	//	  Los botones de INCREMENTO - DECREMENTO funcionan solo si el 
                                 	//    modo es de configuración.
                                 
                                 REVISAR_INC_DEC:
0003aa 9100 0118                 	LDS		R16, MODO
                                 
                                 	// Si modo es < 4, Salir - BNTS DESHABILITADOS
0003ac 3004                      	CPI		R16, 4
0003ad f148                      	BRLO	FIN_BTN_ISR
                                 
                                 	// Si estamos en modo configuración
0003ae ff11                      	SBRS	R17, 1	
0003af c001                      	RJMP	REVISAR_DEC
0003b0 c023                      	RJMP	BTN_INC_PRESS
                                 
                                 REVISAR_DEC:
0003b1 ff10                      	SBRS	R17, 0
0003b2 c024                      	RJMP	FIN_BTN_ISR
0003b3 c01c                      	RJMP	BTN_DEC_PRESS
                                 
0003b4 c022                      	RJMP	FIN_BTN_ISR
                                 
                                 	// ================================ //
                                 	// BTN COMODIN PRESIONADO
                                 	// ================================ //
                                 BTN_COMODIN_PRESS:
                                 
                                 	// alarma sonando?
0003b5 9b2c                      	SBIS	PORTB, 4
0003b6 c005                      	RJMP	VERIFICAR_GUARDADO
                                 
                                 	// apagar alarma
0003b7 982c                      	CBI		PORTB, 4
0003b8 e000                      	LDI		R16, 0
0003b9 9300 0119                 	STS		ALARMA, R16
0003bb c01b                      	RJMP	FIN_BTN_ISR
                                 
                                 VERIFICAR_GUARDADO:
                                 	
                                 	// modo configuracion?
0003bc 9100 0118                 	LDS		R16, MODO
0003be 3004                      	CPI		R16, 4
0003bf f0b8                      	BRLO	FIN_BTN_ISR
                                 
                                 	// Guardar nuevos valores
0003c0 e001                      	LDI		R16, 1
0003c1 9300 0120                 	STS		GUARDAR_VALORES, R16
0003c3 c013                      	RJMP	FIN_BTN_ISR
                                 
                                 	// ================================ //
                                 	// BTN MODO PRESIONADO
                                 	// ================================ //
                                 BTN_MODO_PRESS:
                                 
0003c4 9100 0118                 	LDS		R16, MODO
0003c6 3009                      	CPI		R16, 9								// martener margen de 9 modos
0003c7 f021                      	BREQ	CAMBIO_MODO
0003c8 9503                      	INC		R16
0003c9 9300 0118                 	STS		MODO, R16
0003cb c00b                      	RJMP	FIN_BTN_ISR
                                 
                                 CAMBIO_MODO:
0003cc e001                      	LDI		R16, 1
0003cd 9300 0118                 	STS		MODO, R16
0003cf c007                      	RJMP	FIN_BTN_ISR
                                 
                                 	// ================================ //
                                 	// BTN DECREMENTO PRESIONADO
                                 	// ================================ //
                                 BTN_DEC_PRESS:
                                 	
0003d0 e001                      	LDI		R16, 1
0003d1 9300 011f                 	STS		BTN_DEC, R16
0003d3 c003                      	RJMP	FIN_BTN_ISR
                                 
                                 	// ================================ //
                                 	// BTN INCREMENTO PRESIONADO
                                 	// ================================ //
                                 BTN_INC_PRESS:
                                 
0003d4 e001                      	LDI		R16, 1
0003d5 9300 011e                 	STS		BTN_INC, R16
                                 
                                 FIN_BTN_ISR:
0003d7 910f                      	POP		R16
0003d8 bf0f                      	OUT		SREG, R16							// Restaurar Status Register
0003d9 911f                      	POP		R17
0003da 910f                      	POP		R16
                                 
0003db 9518                      	RETI
                                 
