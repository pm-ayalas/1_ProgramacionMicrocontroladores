                                 ENVIAR_A_DISPLAY:
                                 	
0002bd 93ff                      	PUSH	ZH
0002be 93ef                      	PUSH	ZL
0002bf 930f                      	PUSH	R16
0002c0 931f                      	PUSH	R17
                                     
                                 	// Buscar configuración de segmentos en VECTOR
0002c1 0f44                      	LSL		R20									// mult por 2 porque dw ocupa 2 bytes
0002c2 e0f7                      	LDI		ZH, HIGH(VECTOR*2)
0002c3 ebe8                      	LDI		ZL, LOW(VECTOR*2)
0002c4 e000                      	LDI		R16, 0
0002c5 0fe4                      	ADD		ZL, R20
0002c6 1ff0                      	ADC		ZH, R16								// ZH = ZH + R16 + C (sumar acarreo si hubo)
0002c7 9144                      	LPM		R20, Z								// Load Program Memory (cargar según puntero)
                                     
                                 	// No modificar estado de PUNTITOS
0002c8 9150 011d                 	LDS		R21, PUNTITOS
0002ca 2b45                      	OR		R20, R21
                                 
                                     // Enviar a Puerto
0002cb b94b                      	OUT		PORTD, R20
                                     
0002cc 911f                      	POP		R17
0002cd 910f                      	POP		R16
0002ce 91ef                      	POP		ZL
0002cf 91ff                      	POP		ZH
0002d0 9508                      	RET
                                 
