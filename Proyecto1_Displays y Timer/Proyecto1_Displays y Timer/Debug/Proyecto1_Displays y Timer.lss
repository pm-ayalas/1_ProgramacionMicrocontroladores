                                 	// ================================ //
00034e 9100 010b                 	LDS		R16, TEMP_MIN_UNIDAD
000350 3009                      	CPI		R16, 9
000351 f021                      	BREQ	REINICIO32
000352 9503                      	INC		R16
000353 9300 010b                 	STS		TEMP_MIN_UNIDAD, R16
000355 c00e                      	RJMP	FIN_REFRESCAR_MODO4
                                 
                                 REINICIO32:
