0002d8 c074                      	RJMP	FIN_REFRESCAR_RELOJ
                                 
                                 REINICIO1:
0002d9 e000                      	LDI		R16, 0
0002da 9300 0100                 	STS		SEG_UNIDAD, R16	
                                 
